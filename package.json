{
  "name": "statetrace",
  "description": "A WebMCP-native transaction debugger for visible, recoverable human-agent workflows.",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "Atul Sharma",
  "type": "module",
  "homepage": "https://state-trace.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Iltwats/stateTrace.git"
  },
  "bugs": {
    "url": "https://github.com/Iltwats/stateTrace/issues"
  },
  "keywords": [
    "webmcp",
    "mcp",
    "model-context-protocol",
    "agentic-web",
    "human-in-the-loop",
    "optimistic-ui",
    "transactions",
    "observability",
    "react"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "lint-staged": {
    "*.{css,html,js,jsx,json,md,ts,tsx,yaml,yml}": "prettier --write"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "webmcp-types": "^0.1.5"
  }
}
